# Copy to .env and adjust as needed.

# --- PostgreSQL ---
POSTGRES_USER=bioalign
POSTGRES_PASSWORD=bioalign
POSTGRES_DB=bioalign
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://bioalign:bioalign@localhost:5432/bioalign

# --- FastAPI backend ---
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
CORS_ORIGINS=http://localhost:3000

# --- Frontend (Next.js) ---
# Also copy NEXT_PUBLIC_API_URL into frontend/.env
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- ML / device ---
# cpu | cuda
DEVICE=cpu
DATA_DIR=./data
HVG_COUNT=2000
PCA_COMPONENTS=30
N_CLUSTERS=8
BOOTSTRAP_ITERATIONS=12
RANDOM_STATE=0
